<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- App theme: Material 3 dark. Each screen has its own toolbar
         (res/layout/toolbar.xml) and pads itself clear of the system bars,
         as Android 15+ draws apps edge-to-edge. -->
    <style name="AppTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent_steps</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorSecondary">@color/accent_steps</item>
        <item name="colorPrimaryContainer">#1F3B2A</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/background</item>
        <item name="colorSurfaceContainerHigh">@color/card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
    </style>

    <style name="StatValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_stat</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Label">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="CardTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Body">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
</resources>
