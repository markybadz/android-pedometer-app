<?xml version="1.0" encoding="utf-8"?>
<!-- Main screen: step ring, stat cards, calorie goal, Amazfit watch, activity score -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <include layout="@layout/toolbar" />

<ScrollView android:id="@+id/main_scroll"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <!-- Steps: ring toward the daily step goal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/card"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <FrameLayout
                android:layout_width="@dimen/ring_size"
                android:layout_height="@dimen/ring_size">

                <ProgressBar android:id="@+id/step_ring"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:indeterminate="false"
                    android:max="1000"
                    android:progress="0"
                    android:progressDrawable="@drawable/ring_steps" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView android:id="@+id/step_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_hero"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:text="0" />
                    <TextView android:id="@+id/step_goal_text"
                        style="@style/Label"
                        android:text="@string/steps" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- Distance and calories -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card"
                android:padding="@dimen/card_padding">
                <TextView android:id="@+id/distance_value"
                    style="@style/StatValue"
                    android:text="0" />
                <TextView android:id="@+id/distance_units"
                    style="@style/Label"
                    android:text="@string/kilometers" />
            </LinearLayout>
            <Space android:layout_width="@dimen/card_gap" android:layout_height="0dp" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card"
                android:padding="@dimen/card_padding">
                <TextView android:id="@+id/calories_value"
                    style="@style/StatValue"
                    android:text="0" />
                <TextView
                    style="@style/Label"
                    android:text="@string/calories_burned" />
            </LinearLayout>
        </LinearLayout>

        <!-- Pace and speed -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card"
                android:padding="@dimen/card_padding">
                <TextView android:id="@+id/pace_value"
                    style="@style/StatValue"
                    android:text="0" />
                <TextView
                    style="@style/Label"
                    android:text="@string/steps_per_minute" />
            </LinearLayout>
            <Space android:layout_width="@dimen/card_gap" android:layout_height="0dp" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card"
                android:padding="@dimen/card_padding">
                <TextView android:id="@+id/speed_value"
                    style="@style/StatValue"
                    android:text="0" />
                <TextView android:id="@+id/speed_units"
                    style="@style/Label"
                    android:text="@string/kilometers_per_hour" />
            </LinearLayout>
        </LinearLayout>

        <!-- Calorie goal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            android:orientation="vertical"
            android:background="@drawable/card"
            android:padding="@dimen/card_padding">
            <TextView
                style="@style/CardTitle"
                android:text="@string/card_calorie_goal" />
            <TextView android:id="@+id/calorie_goal_value"
                style="@style/Body"
                android:text="" />
            <ProgressBar android:id="@+id/calorie_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="10dp"
                android:indeterminate="false"
                android:max="100"
                android:progressDrawable="@drawable/bar_calories" />
        </LinearLayout>

        <!-- Amazfit watch (hidden unless turned on in Settings) -->
        <LinearLayout android:id="@+id/watch_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            android:orientation="vertical"
            android:background="@drawable/card"
            android:padding="@dimen/card_padding"
            android:visibility="gone">
            <TextView
                style="@style/CardTitle"
                android:text="@string/card_watch" />
            <TextView android:id="@+id/watch_value"
                style="@style/Body"
                android:text="" />
        </LinearLayout>

        <!-- Google Health sharing (hidden unless turned on in Settings) -->
        <LinearLayout android:id="@+id/health_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            android:orientation="vertical"
            android:background="@drawable/card"
            android:padding="@dimen/card_padding"
            android:visibility="gone">
            <TextView
                style="@style/CardTitle"
                android:text="@string/card_google_health" />
            <TextView android:id="@+id/health_value"
                style="@style/Body"
                android:text="" />
        </LinearLayout>

        <!-- Activity score (PAI-style estimate) -->
        <LinearLayout android:id="@+id/pai_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            android:orientation="vertical"
            android:background="@drawable/card"
            android:padding="@dimen/card_padding"
            android:visibility="gone">
            <TextView
                style="@style/CardTitle"
                android:text="@string/card_score" />
            <TextView android:id="@+id/pai_value"
                style="@style/Body"
                android:text="" />
            <ProgressBar android:id="@+id/pai_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="10dp"
                android:indeterminate="false"
                android:max="100"
                android:progressDrawable="@drawable/bar_score" />
        </LinearLayout>

        <!-- Desired pace/speed (shown when "Maintain pace/speed" is on) -->
        <LinearLayout android:id="@+id/desired_pace_control"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/card"
            android:padding="@dimen/card_padding">

            <Button android:id="@+id/button_desired_pace_lower"
                android:layout_width="@dimen/button"
                android:layout_height="@dimen/button"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:textSize="@dimen/button_sign"
                android:text="−" />

            <LinearLayout
                android:layout_width="@dimen/desired_pace_width"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <TextView android:id="@+id/desired_pace_label"
                    style="@style/Label"
                    android:text="@string/desired_pace" />
                <TextView android:id="@+id/desired_pace_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/desired_pace"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <Button android:id="@+id/button_desired_pace_raise"
                android:layout_width="@dimen/button"
                android:layout_height="@dimen/button"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:textSize="@dimen/button_sign"
                android:text="+" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>

</LinearLayout>
